# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
logs/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Test / coverage output
coverage/
playwright-report/
test-results/
apps/web/lighthouse-results.json

# Docker volumes (bind-mounted local data, never versioned)
docker/mysql/data/

# Local file storage provider's dev/test-time uploads (never versioned)
apps/api/uploads/

# Database backups (db:backup's default output — never versioned, may
# contain real user/payment/connector-credential data)
backups/
**/backups/
